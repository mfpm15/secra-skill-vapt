#!/usr/bin/python3
"""Privileged SECRA execution gate. Install as root:root 0755 at /usr/local/sbin/secra-run.

NO generic command runner. All manifests are provisioned out-of-band by root;
sudo callers cannot create them. Do not enable until kernel lab suite is green.
"""
from __future__ import annotations

import hashlib
import ipaddress
import json
import os
import re
import stat
import subprocess
import sys
from pathlib import Path
from uuid import UUID

SCOPES = Path("/etc/secra/scopes")
WORK = Path("/var/lib/secra/work")
EVIDENCE = Path("/var/lib/secra/evidence")
NMAP = "/usr/bin/nmap"
CURL = "/usr/bin/curl"
PORTS = "21,22,23,25,53,80,110,111,135,139,143,443,445,993,995,1723,3306,3389,5900,8080"
HTTP_PORTS = {80, 443, 8000, 8008, 8080, 8081, 8443, 8888, 3000, 5000, 9443}
NMAP_FIXED = ("-sT", "-Pn", "-n", "-T2", "--max-retries", "1", "--host-timeout",
              "45s", "-p", PORTS, "-oX", "-")
CURL_FIXED = ("-q", "--noproxy", "*", "--proto", "=http,https",
              "--max-redirs", "0", "--connect-timeout", "3", "--max-time", "7",
              "--silent", "--show-error", "--head", "--insecure")
UUID_PATTERN = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\Z")
DIGEST = re.compile(r"[0-9a-f]{64}\Z")


class Denied(RuntimeError):
    pass


def canonical_uuid(text: str) -> str:
    if not isinstance(text, str) or not UUID_PATTERN.fullmatch(text):
        raise Denied("ID_INVALID")
    if str(UUID(text)) != text:
        raise Denied("ID_NOT_CANONICAL")
    return text


def check_directory(path: Path) -> None:
    if path.is_symlink():
        raise Denied("ROOT_DIRECTORY_SYMLINK")
    st = path.stat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        raise Denied("ROOT_DIRECTORY_PERMISSIONS")


def root_file(path: Path) -> dict:
    if path.is_symlink():
        raise Denied("MANIFEST_SYMLINK")
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0
                or st.st_mode & 0o022 or st.st_size > 16384):
            raise Denied("MANIFEST_PERMISSIONS")
        data = os.read(fd, 16385)
    finally:
        os.close(fd)
    try:
        result = json.loads(data)
    except (ValueError, UnicodeError) as exc:
        raise Denied("MANIFEST_INVALID") from exc
    if not isinstance(result, dict):
        raise Denied("MANIFEST_INVALID")
    return result


def scope_manifest(eid: str) -> dict:
    check_directory(SCOPES)
    manifest = root_file(SCOPES / (eid + ".json"))
    if set(manifest) != {"engagement", "target", "scope", "binaries", "authorized"}:
        raise Denied("MANIFEST_FIELDS")
    if manifest["engagement"] != eid or manifest["authorized"] is not True:
        raise Denied("MANIFEST_UNAUTHORIZED")
    target = manifest["target"]
    try:
        address = ipaddress.ip_address(target)
        if (address.version != 4 or address.is_loopback or address.is_link_local
                or address.is_multicast or address.is_unspecified or address.is_reserved):
            raise Denied("TARGET_UNSAFE")
        nets = tuple(ipaddress.ip_network(x, strict=False) for x in manifest["scope"])
        if not (0 < len(nets) <= 32 and all(n.version == 4 for n in nets)
                and any(address in n for n in nets)):
            raise Denied("TARGET_NOT_IN_SCOPE")
    except (ValueError, TypeError, KeyError) as exc:
        raise Denied("SCOPE_INVALID") from exc
    if target != str(address):
        raise Denied("TARGET_NONCANONICAL")
    binary_hashes = manifest["binaries"]
    if (not isinstance(binary_hashes, dict) or set(binary_hashes) != {"nmap", "curl"}
            or not all(isinstance(h, str) and DIGEST.fullmatch(h) for h in binary_hashes.values())):
        raise Denied("BINARY_PINS_INVALID")
    return manifest


def verify_argv(argv: list[str], manifest: dict) -> None:
    if not argv or not all(isinstance(x, str) and x for x in argv):
        raise Denied("ARGV_MISSING")
    target = manifest["target"]
    if argv[0] == NMAP:
        if tuple(argv[1:]) != (*NMAP_FIXED, target):
            raise Denied("NMAP_UNREVIEWED_ARGV")
        name = "nmap"
    elif argv[0] == CURL:
        if tuple(argv[1:-1]) != CURL_FIXED:
            raise Denied("CURL_UNREVIEWED_ARGV")
        url = argv[-1]
        matched = re.fullmatch(r"(http|https)://([0-9.]+):([0-9]{2,5})/", url)
        if not matched or matched[2] != target or int(matched[3]) not in HTTP_PORTS:
            raise Denied("CURL_TARGET_INVALID")
        if matched[1] != ("https" if int(matched[3]) in {443, 8443, 9443} else "http"):
            raise Denied("CURL_SCHEME_INVALID")
        name = "curl"
    else:
        raise Denied("BINARY_UNREVIEWED")
    path = Path(argv[0])
    if path.is_symlink() or not path.is_file():
        raise Denied("BINARY_UNSAFE")
    with path.open("rb") as f:
        digest = hashlib.file_digest(f, "sha256").hexdigest()
    if digest != manifest["binaries"][name]:
        raise Denied("BINARY_DIGEST_MISMATCH")


def unit_name(run_id: str) -> str:
    return "secra-" + canonical_uuid(run_id) + ".scope"


def systemd_argv(eid: str, run_id: str, argv: list[str], manifest: dict) -> list[str]:
    """Do not use sudo/systemd-run as a general-purpose command interpreter."""
    check_directory(WORK)
    check_directory(EVIDENCE)
    work_dir = WORK / eid
    if work_dir.is_symlink() or not work_dir.is_dir():
        raise Denied("WORKSPACE_MISSING")
    # Other users may be able to write their engagement work dir, but not
    # configuration or executable paths. Preserve cwd only for reviewed tools.
    if work_dir.stat().st_uid not in {0, __import__("pwd").getpwnam("secra").pw_uid}:
        raise Denied("WORKSPACE_OWNER")
    target = manifest["target"]
    return [
        "/usr/bin/systemd-run", "--system", "--quiet", "--scope", "--collect",
        "--uid=secra", "--no-ask-password", "--unit=" + unit_name(run_id),
        "--property=MemoryMax=536870912", "--property=CPUQuota=50%",
        "--property=TasksMax=32", "--property=IPAddressDeny=any",
        "--property=IPAddressAllow=" + target + "/32",
        "--property=NoNewPrivileges=yes", "--property=PrivateTmp=yes",
        "--property=ProtectSystem=strict",
        "--property=ReadWritePaths=" + str(EVIDENCE) + " " + str(work_dir),
        "--working-directory=" + str(work_dir), "--", *argv,
    ]


def command(args: list[str]) -> list[str]:
    if not args:
        raise Denied("COMMAND_MISSING")
    if args[0] == "stop" and len(args) == 3 and args[1] == "--run":
        return ["/usr/bin/systemctl", "--system", "--no-ask-password", "stop",
                unit_name(args[2])]
    if (len(args) < 8 or args[0] != "exec" or args[1] != "--engagement"
            or args[3] != "--run" or args[5] != "--"):
        raise Denied("COMMAND_SHAPE_INVALID")
    eid, run_id = canonical_uuid(args[2]), canonical_uuid(args[4])
    manifest = scope_manifest(eid)
    argv = args[6:]
    verify_argv(argv, manifest)
    return systemd_argv(eid, run_id, argv, manifest)


def main() -> int:
    try:
        if os.geteuid() != 0 or os.environ.get("SUDO_USER") != "secra-api":
            raise Denied("CALLER_NOT_AUTHORIZED")
        safe = command(sys.argv[1:])
        # No shell; sanitized environment; stdout/stderr forwarded to the
        # unprivileged, encrypted evidence reader in the calling gateway.
        os.execve(safe[0], safe, {"PATH": "/usr/bin:/bin", "HOME": "/nonexistent",
                                  "LC_ALL": "C", "LANG": "C"})
    except (Denied, OSError, ValueError, KeyError) as exc:
        # Never log target, scope, raw argv or manifest content.
        print("SECRA_RUN_DENIED", file=sys.stderr)
        return 126


if __name__ == "__main__":
    sys.exit(main())
